{
  "name": "latent",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "description": "Open-source camera-backed look lab for Fujifilm photographers",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern packages apps",
    "format": "prettier --write packages apps",
    "format:check": "prettier --check packages apps",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "license-check": "license-checker --production --excludePrivatePackages --onlyAllow 'MIT;AGPL-3.0;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC;CC-BY-4.0;CC0-1.0'",
    "lockstep-check": "tsx scripts/check-schema-translator-lockstep.ts",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run license-check && npm run lockstep-check"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "license-checker": "^25",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vitest": "^2"
  }
}
